# ==============================================================================
# ClassLens Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local runtime overrides.
# NOTE: Do NOT commit .env containing live credentials or production keys.

# Application Environment
ENVIRONMENT=development
APP_NAME=ClassLens
DEBUG=true

# Deterministic Mock Mode (Defaults to true for 100% offline local development)
# Set to false only when authorized to perform live Google Cloud / Gemini API testing.
MOCK_LLM=true

# Security & Session Authentication
# In production, generate a cryptographically strong 32-character secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=classlens-dev-secret-key-replace-with-secure-random-value-in-prod!

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Cloud & Gemini Multimodal Configuration
# Planned for Gate 2 live validation in region asia-southeast1 (Singapore)
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here
GOOGLE_CLOUD_LOCATION=asia-southeast1
# For direct developer API usage (optional):
# GOOGLE_GENAI_API_KEY=your-gemini-api-key-placeholder

# Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
