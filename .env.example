# ==============================================================================
# ClassLens Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local runtime overrides.
# NOTE: .env is ignored by Git and must NEVER contain live secrets or production credentials.

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME=ClassLens API
DEBUG=true

# ------------------------------------------------------------------------------
# AI Execution Mode Controls (Dual-Gate Safety)
# ------------------------------------------------------------------------------
# CLASSLENS_AI_MODE:
#   - "mock" (default): 100% offline, deterministic synthetic fixtures, zero API calls
#   - "live": Google Cloud Vertex AI inference (requires CLASSLENS_LIVE_INFERENCE_ENABLED=true)
CLASSLENS_AI_MODE=mock

# CLASSLENS_LIVE_INFERENCE_ENABLED:
#   - false (default): Hard block preventing live network calls to Gemini
#   - true: Explicit opt-in enabling Vertex AI calls (only active if CLASSLENS_AI_MODE=live)
CLASSLENS_LIVE_INFERENCE_ENABLED=false

# Hard software circuit breaker capping maximum live model calls per run (default: 3)
CLASSLENS_MAX_LIVE_CALLS=3

# Legacy compatibility flag (default: true for offline mock execution)
MOCK_LLM=true

# ------------------------------------------------------------------------------
# Google Cloud Vertex AI & Gemini Multimodal Configuration
# ------------------------------------------------------------------------------
# Google Cloud Project ID (safe placeholder; set your GCP project ID in .env)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here

# Vertex AI regional location or global endpoint (Gate 3C/4A uses 'global')
GOOGLE_CLOUD_LOCATION=global

# Google Gen AI SDK backend selector (true for Vertex AI via ADC)
GOOGLE_GENAI_USE_VERTEXAI=true

# Gemini Vision Model ID (verified Vertex AI model catalog ID)
CLASSLENS_GEMINI_MODEL=gemini-3.8-flash

# Optional legacy model identifier
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Security, Session & Authentication
# ------------------------------------------------------------------------------
# In production, generate a cryptographically strong 32-character secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=classlens-dev-secret-key-replace-with-secure-random-value-in-prod!

# Teacher Reviewer Account Credentials (Argon2id protected)
# Password for teacher@classlens.demo (Mrs. Sarah Lim, Cedar Secondary School)
# Set your local password here, then run: python scripts/init_teacher.py
CLASSLENS_DEMO_PASSWORD=your-local-reviewer-password-here

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Local Storage & Database Configuration
# ------------------------------------------------------------------------------
# Path to local storage directory for SQLite database (classlens.db) and uploaded worksheets
LOCAL_DATA_DIR=local-data
# SQLite database filename inside LOCAL_DATA_DIR (default: classlens.db)
SQLITE_DB_NAME=classlens.db

# Production Storage & Cloud SQL Database Options:
# Google Cloud Storage bucket for durable uploaded worksheets (production)
# CLASSLENS_GCS_BUCKET=classlens-worksheets-prod
# PostgreSQL database connection string (e.g. Cloud SQL via Auth Proxy)
# CLASSLENS_DATABASE_URL=postgresql://classlens_user:secure_password@127.0.0.1:5432/classlens

# ------------------------------------------------------------------------------
# Frontend Configuration (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
